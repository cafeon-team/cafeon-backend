// ==================== CafeON domain tables ====================

Table comments {
  id bigint [pk, increment, not null]
  post_id bigint [not null]
  user_id bigint [not null]
  parent_id bigint
  content text [not null]
  status varchar(20) [not null, default: 'VISIBLE']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    parent_id
    (post_id, status, created_at)
    (user_id, created_at)
  }
}

Table coupons {
  id bigint [pk, increment, not null]
  store_id bigint [not null]
  created_by bigint [not null]
  name varchar(100) [not null]
  description varchar(500)
  discount_type varchar(30) [not null, note: 'enum(FIXED,PERCENT,FREE_ITEM)']
  discount_value decimal(12,2) [not null, default: 0.00]
  minimum_order_amount decimal(12,2) [not null, default: 0.00]
  maximum_discount_amount decimal(12,2)
  free_menu_id bigint
  valid_from timestamp [not null]
  valid_until timestamp [not null]
  total_quantity int
  issued_quantity int [not null, default: 0]
  per_user_limit int [not null, default: 1]
  is_active boolean [not null, default: 1]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    created_by
    free_menu_id
    (store_id, is_active, valid_until)
  }
}

Table customer_inquiries {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
